{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist/renderer",
    // c924-15：本行原值是**仓库外**的绝对路径 "D:/colony-game/.tsbuildinfo/renderer.tsbuildinfo"
    // （仓内真实根是 D:/code/colony-game）。它今天完全惰性——三份工程都没开 incremental/composite。
    // 改前语义与两种归因（"另一台机器的布局残留" / "D 盘缓存根惯例的掉队者"）见
    // docs/insights/colony-typecheck-mainpreload-design-20260924.md §5（c924-04）——该节把这三行
    // 定为"方案 B（composite）的前置卫生项"，并建议目标写成仓内相对路径。
    // 现按 c924-15 卷宗口径收进仓内 ./.tsbuildinfo/，命中的是 .gitignore:5 既有忽略面（无需新增规则）。
    // ⚠ 别改回 D:/ 形态：本仓缓存根已在迁回仓内（electron.vite.config.ts:5 的 cacheDir 即仓内），
    //   而 D 盘惯例在 src/main/index.ts:6-8 与 dev.bat/install.bat 里**仍然活着**，两者并存易被误读。
    "tsBuildInfoFile": "./.tsbuildinfo/renderer.tsbuildinfo",
    "types": []
  },
  // vitest 4 迁移（2026-11-14）：vitest 1.x 的 d.ts 会把 @types/node 全局（process/__dirname/
  // node:fs…）传递泄漏进本工程——__tests__ 下的测试文件靠这个泄漏用 node API 而不报错。
  // vitest 4 的类型不再引用 @types/node（官方破坏性变更），测试文件的 node 用法随之暴露。
  // 处置：产品面保持 types:[] 的 DOM 纯净不动；__tests__ 摘到 tsconfig.test.json
  //（types:["node"]）单独过 type-check。产品文件全部仍在本工程受 types:[] 门禁。
  "include": ["src/renderer/**/*"],
  "exclude": ["src/renderer/**/__tests__/**"]
}
